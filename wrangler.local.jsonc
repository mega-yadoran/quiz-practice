{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "q-practice",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": { "ENVIRONMENT": "local", "OWNER_EMAIL": "yado@mega-yadoran.jp", "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "", "TTS_PROVIDER": "google", "GOOGLE_TTS_VOICE": "ja-JP-Standard-D" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "q-practice",
    "database_id": "c9357dee-fc09-4714-8676-6078674d6fe2",
    "migrations_dir": "migrations"
  }]
}
