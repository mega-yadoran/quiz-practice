{
  "name": "q-practice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --config wrangler.local.jsonc --ip 127.0.0.1 --port 8797",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:integration": "node scripts/integration.mjs",
    "speech:intro": "node scripts/generate-speech-intro.mjs",
    "db:local": "wrangler d1 migrations apply q-practice --local --config wrangler.local.jsonc",
    "db:remote": "wrangler d1 migrations apply q-practice --remote",
    "deploy": "npm run build && wrangler deploy",
    "check:deploy": "npm run build && wrangler deploy --dry-run",
    "check:production": "node scripts/check-production.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "hono": "^4.13.17",
    "jose": "^6.2.15",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
